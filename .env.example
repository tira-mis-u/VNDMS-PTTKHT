# ==============================================================================
# VNDMS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# 1. NDAMAPVN
VITE_NDAMAPVN_API_KEY=your_ndamapvn_api_key_here
VITE_NDAMAPVN_TILE_URL=https://tiles.ndamapvn.gov.vn/styles/vietnam/{z}/{x}/{y}.png
VITE_NDAMAPVN_ROUTING_API_URL=https://api.ndamapvn.gov.vn/v1/routing

# 2. SUPABASE
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. REDIS
VITE_UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
VITE_UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
REDIS_URL=redis://default:password@localhost:6379
