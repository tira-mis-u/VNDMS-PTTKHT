        <mxCell id="page_SD_11___BanCapNhatHienTruong_v_9" value="&lt;div style=&quot;font-family:Arial,sans-serif;font-size:8.0px;line-height:1.22;color:#1f2937;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:10.0px;font-weight:700;margin-bottom:5px;text-align:center;&quot;&gt;SD-11 - BanCapNhatHienTruong — page_SD_11___BanCapNhatHienTruong_v_9&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1px solid #d1d5db;margin:0 0 5px 0;&quot;&gt;Không tự thêm eventSource chỉ chứng minh chuyển khi ghi bản cập nhật hoặc đồng bộ lại.&lt;br&gt;Đây là state của BanCapNhatHienTruong, không phải state mới của NhiemVuCuuHo.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;gradientColor=none;strokeColor=#cbd5e1;strokeWidth=0.8;shadow=0;fontColor=#374151;fontFamily=Arial;fontSize=8.2;align=left;verticalAlign=top;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="820.0" y="460" width="740.0" height="155" as="geometry" />
        </mxCell>
        <mxCell id="page_SD_06___CanhBaoCongBo_v_11" value="&lt;div style=&quot;font-family:Arial,sans-serif;font-size:8.0px;line-height:1.22;color:#1f2937;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:10.0px;font-weight:700;margin-bottom:5px;text-align:center;&quot;&gt;SD-06 - CanhBaoCongBo — page_SD_06___CanhBaoCongBo_v_11&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1px solid #d1d5db;margin:0 0 5px 0;&quot;&gt;Thuộc tính phụmucDo: critical / high / medium / low.&lt;br&gt;Đây là severity, không phải state lifecycle.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;gradientColor=none;strokeColor=#cbd5e1;strokeWidth=0.8;shadow=0;fontColor=#374151;fontFamily=Arial;fontSize=8.2;align=left;verticalAlign=top;spacing=5;" vertex="1" parent="1">
