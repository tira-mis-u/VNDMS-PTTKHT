{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": { "@/*": ["./src/*"] },
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client", "google.maps"],
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["tests/infrastructure/**/*", "src/**/*"],
  "exclude": [
    "src/features/relief/**",
    "src/features/simulation/**",
    "src/features/playbooks/**",
    "src/features/recovery/**",
    "src/features/evacuations/**",
    "src/features/ai-assistant/**",
    "src/application/relief/**",
    "src/application/simulation/**",
    "src/application/playbooks/**",
    "src/application/recovery/**",
    "src/application/evacuations/**",
    "src/application/ai/**",
    "src/domain/relief/**",
    "src/domain/simulation/**",
    "src/domain/playbooks/**",
    "src/domain/recovery/**",
    "src/domain/evacuations/**",
    "src/domain/ai/**",
    "src/data/scenarios/**/playbookSeed.ts",
    "src/features/command-center/components/LogisticsExceptions.tsx",
    "src/features/command-center/components/PlaybookOperations.tsx",
    "src/features/command-center/components/RecoveryExceptions.tsx",
    "src/features/command-center/components/ResourceExceptions.tsx"
  ]
}
